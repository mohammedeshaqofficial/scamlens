# Set to false to skip redirect / WHOIS / Safe Browsing lookups (faster, offline)
SCAMLENS_LIVE_CHECKS=true
# Free key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# Comma-separated origins allowed to call the API when the frontend is hosted elsewhere
ALLOWED_ORIGINS=*
